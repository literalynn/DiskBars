#!/usr/bin/env bash
# Usage: dkb [bar_width]  (default 30)
set -euo pipefail

W=${1:-30}
[[ "$W" =~ ^[0-9]+$ ]] || { echo "Usage: dkb [bar_width]" >&2; exit 1; }

# Detect locale
LC="${LC_ALL:-${LANG:-en_US}}"
if [[ "$LC" =~ ^fr(_|-) || "$LC" == fr ]]; then
  IS_FR=1
  HDR_PHYS="=== Disques physiques ==="
  HDR_MFS="=== MergerFS ==="
  NONE_PHYS="(aucun disque détecté)"
  NONE_MFS="(aucun mount mergerfs)"
  UNIT_TB="To"; UNIT_GB="Go"
else
  IS_FR=0
  HDR_PHYS="=== Physical disks ==="
  HDR_MFS="=== MergerFS mounts ==="
  NONE_PHYS="(no disks detected)"
  NONE_MFS="(no mergerfs mounts)"
  UNIT_TB="TB"; UNIT_GB="GB"
fi

RED=$'\033[31m'; BOLD=$'\033[1m'; RESET=$'\033[0m'

# Reads "name<TAB>label<TAB>size_bytes<TAB>used_bytes" lines and prints one bar per line.
# $1 = label column width, $2 = message when there are no lines
render() {
  awk -F '\t' -v w="$W" -v lw="$1" -v none="$2" -v RED="$RED" -v RESET="$RESET" \
      -v IS_FR="$IS_FR" -v UTB="$UNIT_TB" -v UGB="$UNIT_GB" '
  function fmt(bytes,   s){
    if (bytes >= 1e12) s = sprintf("%.1f %s", bytes/1e12, UTB);
    else               s = sprintf("%.1f %s", bytes/1e9,  UGB);
    if (IS_FR) gsub(/\./,",",s);
    return s;
  }
  {
    n++; name[n]=$1; label[n]=$2; size[n]=$3+0; used[n]=$4+0;
    if(length($1)>nw) nw=length($1);
  }
  END{
    if(n==0){ print none; exit 0 }
    line = "%-" nw "s %s%3d%s%s  %-" lw "." lw "s [%s] %6s  %s%s%s%s%s\n";
    for(i=1;i<=n;i++){
      sz=size[i]; us=used[i];
      pct = (sz>0? us*100/sz : 0);

      # bar (capped at w: RAID/LVM members can report more than their size)
      filled=int(pct*w/100); bar=""; for(j=0;j<w;j++) bar=bar (j<filled ? "█" : "░");

      # short capacity right after name
      if (sz >= 1e12) { capnum=int(sz/1e12+0.5); capunit=UTB; }
      else            { capnum=int(sz/1e9 +0.5); capunit=UGB; }

      pctstr = sprintf("%5.1f%%", pct);
      if (IS_FR) gsub(/\./,",",pctstr);

      printf line, name[i], RED, capnum, capunit, RESET, label[i], bar, pctstr,
             RED "(" RESET, fmt(us), RED "/" RESET, fmt(sz), RED ")" RESET;
    }
  }'
}

echo "${BOLD}${HDR_PHYS}${RESET}"
# Used space of a disk = sum of fsused over all its partitions/volumes
{ lsblk -b -J -o NAME,TYPE,SIZE,MODEL,FSUSED || echo '{}'; } | jq -r '
  .blockdevices? // []
  | map(select(.type=="disk"))
  | .[]
  | [
      (.name // "unk"),
      (.model // "Unknown"),
      (.size // 0),
      ( [ . | .. | objects | .fsused? | tonumber? ] | add // 0 )
    ] | @tsv
' | render 26 "$NONE_PHYS"

echo
echo "${BOLD}${HDR_MFS}${RESET}"
{ df -B1 -TP 2>/dev/null || true; } | awk '
$2=="fuse.mergerfs" && NR>1 {
  n=$7; gsub(/.*\//,"",n); if(n=="") n="/";
  print n "\tmergerfs\t" $3 "\t" $4;
}' | render 9 "$NONE_MFS"
